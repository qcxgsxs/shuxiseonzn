# .env.template
# 将此文件复制为 .env 并填写实际值

# 若你有 Ozon 卖家 API Key，请填入（可选）
OZON_API_KEY=

# 测试抓取用的示例 URL 或 SKU（可选）
SAMPLE_URL=
SAMPLE_SKU=

# 调度设置
CRAWL_RATE_SECONDS=2
DAILY_CHECK_TIME=02:15

# 汇率缓存（秒）
EXCHANGE_RATE_CACHE_TTL=3600

# 通知（启用 Telegram 时填写）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Flask 服务器设置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

